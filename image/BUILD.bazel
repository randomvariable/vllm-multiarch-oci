"""Runtime-system layer for the VLLMB12X CUDA image."""

load("@runtime_deps//:requirements.bzl", "all_whl_requirements_by_package")
load("@runtime_deps_x86_64//:requirements.bzl", runtime_x86_requirements = "all_whl_requirements_by_package")
load("@rules_oci//oci:defs.bzl", "oci_image_index", "oci_push")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel:accounts_layer.bzl", "accounts_layer")
load("//bazel:provenance_layer.bzl", "provenance_layer")
load("//bazel:venv_layer.bzl", "venv_layer")
load("//bazel:vllm_image.bzl", "vllm_image")
load("//profiles/vllmb12x:description.bzl", "VLLM_IMAGE_DESCRIPTION")
load("//profiles/vllmb12x:version.bzl", "VLLM_BUILD_VERSION", "VLLM_SOURCE_REF", "VLLM_SOURCE_REVISION")

package(default_visibility = ["//visibility:public"])

# The imported CUDA image owns CUDA, cuDNN, and their NVIDIA package closure.
# This layer only supplies host tools that vLLM or the B12X runtime requires.
filegroup(
    name = "runtime_apt",
    srcs = select({
        "//platforms:linux_aarch64": ["@runtime_apt//:flat"],
        "//platforms:linux_x86_64": ["@runtime_apt_x86_64//:flat"],
    }),
)

_EXCLUDED_RUNTIME_WHEELS = [
    "cuda_toolkit",
    "flashinfer_cubin",
    "flashinfer_python",
    "nvidia_cublas",
    "nvidia_cuda_cccl",
    "nvidia_cuda_crt",
    "nvidia_cuda_cupti",
    "nvidia_cuda_nvcc",
    "nvidia_cuda_nvdisasm",
    "nvidia_cuda_nvrtc",
    "nvidia_cuda_runtime",
    "nvidia_cudnn_cu13",
    "nvidia_cufft",
    "nvidia_cufile",
    "nvidia_curand",
    "nvidia_cusolver",
    "nvidia_cusparse",
    "nvidia_nccl_cu13",
    "nvidia_cusparselt_cu13",
    "nvidia_nvjitlink",
    "nvidia_nvshmem_cu13",
    "nvidia_nvtx",
    "nvidia_nvvm",
    "torch",
    "torchaudio",
    "torchvision",
    # The profile builds the pinned source revision as 0.1.9. Do not install
    # vLLM's unconstrained PyPI 0.2.0 alongside it.
    "instanttensor",
    "llguidance",
    "xgrammar",
]

_REPLACED_RUNTIME_WHEELS = [
    "nvidia_cudnn_cu13",
    "nvidia_nccl_cu13",
]

_RUNTIME_WHEELS = select({
    "//platforms:linux_aarch64": [
        "@runtime_deps//{}:raw_whl".format(name)
        for name in all_whl_requirements_by_package
        if name not in _EXCLUDED_RUNTIME_WHEELS + _REPLACED_RUNTIME_WHEELS
    ],
    "//platforms:linux_x86_64": [
        "@runtime_deps_x86_64//{}:raw_whl".format(name)
        for name in runtime_x86_requirements
        if name not in _EXCLUDED_RUNTIME_WHEELS + _REPLACED_RUNTIME_WHEELS
    ],
})

_IMAGE_BASE = select({
    # The b12x PLE reader and RoCE proxy compile inside the running container
    # (b12x/loader/_native.py, b12x/comm/roce/_proxy.py), so the base must ship
    # a C compiler, the CUDA headers under CUDA_HOME, the libcudart.so link,
    # and libgomp.so.1 for torch's OpenMP. Only the cudnn-devel variant has
    # all four; the runtime variant passed nothing but file-existence tests.
    "//platforms:linux_aarch64": "@cuda_1341_cudnn_devel_ubuntu2604_linux_arm64//:cuda_1341_cudnn_devel_ubuntu2604_linux_arm64",
    "//platforms:linux_x86_64": "@cuda_1341_cudnn_devel_ubuntu2604_linux_amd64//:cuda_1341_cudnn_devel_ubuntu2604_linux_amd64",
})
filegroup(
    name = "cusparselt_layer",
    srcs = select({
        "//platforms:linux_aarch64": ["@cuda_sbsa//:cusparselt.tar"],
        "//platforms:linux_x86_64": ["@cuda_x86_64//:cusparselt.tar"],
    }),
)

write_file(
    name = "vllmb12x_arm64_env",
    out = "vllmb12x-arm64.env",
    content = [
        "CUDA_HOME=/usr/local/cuda",
        "FLASHINFER_CUDA_ARCH_LIST=12.0f",
        "LD_LIBRARY_PATH=/opt/nccl/lib:/opt/cusparselt/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH",
        "LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libmimalloc.so.3",
        "PATH=/opt/venv/bin:$PATH",
        "TORCH_CUDA_ARCH_LIST=12.0+PTX",
        "VLLM_DISABLED_KERNELS=MarlinFP8ScaledMMLinearKernel",
    ],
)

write_file(
    name = "vllmb12x_x86_64_env",
    out = "vllmb12x-x86_64.env",
    content = [
        "CUDA_HOME=/usr/local/cuda",
        "FLASHINFER_CUDA_ARCH_LIST=12.0",
        "LD_LIBRARY_PATH=/opt/nccl/lib:/opt/cusparselt/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH",
        "LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libmimalloc.so.3",
        "PATH=/opt/venv/bin:$PATH",
        "TORCH_CUDA_ARCH_LIST=12.0",
        "VLLM_DISABLED_KERNELS=MarlinFP8ScaledMMLinearKernel",
    ],
)

_IMAGE_ENV = select({
    "//platforms:cuda_sm12x": ":vllmb12x_arm64_env",
    "//platforms:cuda_sm120": ":vllmb12x_x86_64_env",
})

venv_layer(
    name = "runtime_venv",
    python = "@python_3_12//:python3",
    python_runtime = "@python_3_12//:files",
    nccl = "//components/nccl:sdk",
    include_launchers = True,
    include_nccl = True,
    include_python = True,
    runtime_wheels = _RUNTIME_WHEELS,
    source_wheels = [
        "//components:torch",
        "//components:torchvision",
        "//components:torchaudio",
        "//components:flashinfer_python",
        "//components:flashinfer_jit_cache",
        "//components:deepgemm",
        "//components:b12x",
        "//components:xgrammar",
        "//components:exllamav3",
        "//components:lmcache",
        "//components:instanttensor",
        "//components:llguidance",
    ],
    output = "runtime-venv.tar",
)

# Keep the stable interpreter and dependency closure below the vLLM package.
# A native vLLM edit now reassembles only this small overlay layer.
venv_layer(
    name = "vllm_venv",
    python = "@python_3_12//:python3",
    python_runtime = "@python_3_12//:files",
    nccl = "//components/nccl:sdk",
    source_wheels = ["//components:vllm"],
    output = "vllm-venv.tar",
)

provenance_layer(
    name = "vllmb12x_sources_lock",
    manifest = "//profiles/vllmb12x:profile.json",
    build_version = VLLM_BUILD_VERSION,
    source_identities = {
        "b12x": "@vllmb12x_b12x//:source.identity.json",
        "cutlass": "@vllmb12x_cutlass//:source.identity.json",
        "deepgemm": "@vllmb12x_deepgemm//:source.identity.json",
        "exllamav3": "@vllmb12x_exllamav3//:source.identity.json",
        "flashinfer": "@vllmb12x_flashinfer//:source.identity.json",
        "instanttensor": "@vllmb12x_instanttensor//:source.identity.json",
        "lmcache": "@vllmb12x_lmcache//:source.identity.json",
        "llguidance": "@vllmb12x_llguidance//:source.identity.json",
        "nccl": "@vllmb12x_nccl//:source.identity.json",
        "torch": "@vllmb12x_torch//:source.identity.json",
        "torchaudio": "@vllmb12x_torchaudio//:source.identity.json",
        "torchvision": "@vllmb12x_torchvision//:source.identity.json",
        "vllm": "@vllmb12x_vllm//:source.identity.json",
        "vllm_cmake_cutlass": "@vllmb12x_vllm_cmake_cutlass//:source.identity.json",
        "vllm_cmake_deepgemm": "@vllmb12x_vllm_cmake_deepgemm//:source.identity.json",
        "vllm_cmake_deepselect": "@vllmb12x_vllm_cmake_deepselect//:source.identity.json",
        "vllm_cmake_flash_attn": "@vllmb12x_vllm_cmake_flash_attn//:source.identity.json",
        "vllm_cmake_flashkda": "@vllmb12x_vllm_cmake_flashkda//:source.identity.json",
        "vllm_cmake_flashmla": "@vllmb12x_vllm_cmake_flashmla//:source.identity.json",
        "vllm_cmake_msa": "@vllmb12x_vllm_cmake_msa//:source.identity.json",
        "vllm_cmake_qutlass": "@vllmb12x_vllm_cmake_qutlass//:source.identity.json",
        "vllm_cmake_tml_fa4": "@vllmb12x_vllm_cmake_tml_fa4//:source.identity.json",
        "vllm_cmake_triton": "@vllmb12x_vllm_cmake_triton//:source.identity.json",
        "xgrammar": "@vllmb12x_xgrammar//:source.identity.json",
    },
    output = "vllmb12x-sources-lock.tar",
)

# The base passwd file ends at the `ubuntu` account. A pod that pins its own
# runAsUser gets an unnamed uid, so expanduser("~") resolves to "/" and imports
# that create a workspace below the home directory fail. Name one account at a
# fixed uid so deployments can pin it.
accounts_layer(
    name = "accounts",
    accounts = ["vllm:10001:10001:vLLM runtime:/home/vllm:/bin/bash"],
    base = _IMAGE_BASE,
    groups = ["vllm:10001"],
    output = "accounts.tar",
)

vllm_image(
    name = "vllmb12x_image",
    accounts_layer = ":accounts",
    base = _IMAGE_BASE,
    apt_layer = ":runtime_apt",
    # PyTorch links against cuSPARSELt, which NVIDIA's CUDA devel image omits.
    cuda_layer = ":cusparselt_layer",
    env = _IMAGE_ENV,
    provenance_layer = ":vllmb12x_sources_lock",
    venv_layers = [
        ":runtime_venv",
        ":vllm_venv",
    ],
    title = "vllm-b12x-multi",
    description = VLLM_IMAGE_DESCRIPTION,
    # PEP 440 separates the local version with "+", which a docker tag rejects
    # (its grammar is [A-Za-z0-9_.-]), so the local loader uses "-" instead.
    # The published registry tag is allocated after the build and never carries
    # this string.
    local_tag = VLLM_BUILD_VERSION.replace("+", "-"),
    vllm_version = VLLM_BUILD_VERSION,
    vllm_source_ref = VLLM_SOURCE_REF,
    vllm_revision = VLLM_SOURCE_REVISION,
)

oci_image_index(
    name = "vllmb12x",
    images = [":vllmb12x_image"],
    platforms = [
        "//platforms:blackwell_arm64_sm12x",
        "//platforms:blackwell_x86_64_sm120",
    ],
)

# The publisher supplies its allocated immutable tag at runtime. Keeping the
# repository unset prevents public build metadata from naming CI infrastructure.
oci_push(
    name = "vllmb12x_push",
    image = ":vllmb12x",
)
