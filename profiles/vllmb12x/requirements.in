--extra-index-url https://flashinfer.ai/whl/

# vLLM runtime requirements not built from this profile's pinned source trees.
-r ../../third_party/vllm-common-requirements.txt

# CUDA packages track the latest release, pre-releases included; see the
# bump-vllmb12x-deps skill. Non-CUDA packages track upstream vLLM's pins.
apache-tvm-ffi
cuda-python
cuda-tile
cupy-cuda13x
# Tokenizer backend for VLLM_USE_FASTOKENS=1; vLLM requires >= 0.2.0.
fastokens==0.3.2
fastsafetensors>=0.3.3
humming-kernels[cu13]
nccl4py
# Object-store KV tiering (vllm/v1/kv_offload/tiering/obj). The metapackage
# depends on both nixl-cu13 and nixl-cu12 unconditionally.
nixl
# Upstream vLLM requirements/cuda.txt pin: ngram proposer, JIT monitor and
# vision processors import it.
numba==0.65.0
nvidia-cudnn-frontend
nvidia-cutlass-dsl[cu13]
nvidia-ml-py
nvtx
# CUDA 13 Mooncake Store. Its base distribution owns aiohttp, requests, and
# msgpack; the profile supplies its optional Python modules below.
mooncake-transfer-engine-cuda13
# SSD registration and SPDK target modules use Paramiko. The remaining
# optional Mooncake imports are already supplied by the vLLM profile.
paramiko
# LMCache's source-built wheel does not install its Python dependencies.
# The multiprocess server imports SortedDict during CLI registration.
sortedcontainers
# LMCache server initializes its Prometheus reader during HTTP startup.
opentelemetry-exporter-prometheus
# SparkCache: persistent rank-local NVMe prefix cache for vLLM on GB10
# (github.com/FujitsuPolycom/sparkcache), loaded as a vLLM KV connector. Pure
# Python; its `connector` extra only adds torch, which the image builds from
# source, so the bare package is installed. Pinned exactly because every release
# so far is a pre-release.
sparkcache==0.1.0a2
# GPU video decode backend (vllm/multimodal/video_decoders/pynvvideocodec.py).
PyNvVideoCodec
quack-kernels
tilelang
tokenspeed-mla
torchcodec>=0.14

# Source-built wheels installed by venv_layer, excluded from Bazel's PyPI hub.
# torch, torchvision, torchaudio, flashinfer-python, flashinfer-cubin, xgrammar,
# deepgemm, b12x, vllm, exllamav3, lmcache, instanttensor, llguidance
