load("@container_structure_test//:defs.bzl", "container_structure_test")
load("//bazel:contract_image.bzl", "contract_image", "x86_contract_test")

# Match the OCI index's transitions from the same top-level configuration.
# Selecting the image on the test's target platform would require a different
# invocation baseline, changing the image dependencies' Bazel output paths.
contract_image(
    name = "contract_image_arm64",
    image = "//image:vllmb12x_image",
    image_platform = "//platforms:blackwell_arm64_sm12x",
)

contract_image(
    name = "contract_image_x86_64",
    image = "//image:vllmb12x_image",
    image_platform = "//platforms:blackwell_x86_64_sm120",
)

_ARM64_EXEC = [
    "@platforms//cpu:aarch64",
    "@platforms//os:linux",
]

# Keep one config per test: a Docker cleanup from one config can collect
# layers that the next config still needs. Loading the image and running its
# assertions can exceed the default 300s timeout.
container_structure_test(
    name = "vllmb12x_contract",
    timeout = "long",
    configs = ["vllmb12x.yaml"],
    driver = "docker",
    exec_compatible_with = _ARM64_EXEC,
    image = ":contract_image_arm64",
    platform = "linux/arm64",
)

container_structure_test(
    name = "vllmb12x_contract_arch",
    timeout = "long",
    configs = ["vllmb12x-arm64.yaml"],
    driver = "docker",
    exec_compatible_with = _ARM64_EXEC,
    image = ":contract_image_arm64",
    platform = "linux/arm64",
)

# Route only the test action to GB10. Build the same ARM64 image with the
# normal ARM64 execution platform. This checks container dependencies, not
# CUDA kernel correctness.
container_structure_test(
    name = "vllmb12x_contract_sm121a",
    timeout = "long",
    configs = ["vllmb12x.yaml"],
    driver = "docker",
    exec_compatible_with = _ARM64_EXEC,
    exec_properties = {"gpu": "nvidia-gb10"},
    image = ":contract_image_arm64",
    platform = "linux/arm64",
)

container_structure_test(
    name = "vllmb12x_contract_sm121a_arch",
    timeout = "long",
    configs = ["vllmb12x-arm64.yaml"],
    driver = "docker",
    exec_compatible_with = _ARM64_EXEC,
    exec_properties = {"gpu": "nvidia-gb10"},
    image = ":contract_image_arm64",
    platform = "linux/arm64",
)

x86_contract_test(
    name = "vllmb12x_contract_x86_64",
    timeout = "long",
    configs = ["vllmb12x.yaml"],
    driver = "docker",
    image = ":contract_image_x86_64",
    platform = "linux/amd64",
)

x86_contract_test(
    name = "vllmb12x_contract_x86_64_arch",
    timeout = "long",
    configs = ["vllmb12x-x86_64.yaml"],
    driver = "docker",
    image = ":contract_image_x86_64",
    platform = "linux/amd64",
)
