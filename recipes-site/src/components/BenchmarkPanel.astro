---
/**
 * Renders a recipe's measured-performance panel from its `benchmark` block.
 *
 * The figures used to be hand-written HTML inside each recipe page, which meant a
 * recipe could state one number here and another in its golden, with nothing
 * checking the two. They are recipe data now, validated by scripts/build-data.mjs,
 * and src/benchmark.js is the only thing that turns them into markup -- the
 * deployment flow's fourth step calls the same function, so a page and the
 * configurator cannot disagree about what was measured.
 */
import { benchmarkHtml } from "../benchmark.js";
// A static import, not a read from disk: a bundled component's import.meta.url
// resolves into dist/, so opening public/recipes.json from there looks for
// dist/public/recipes.json and fails the build.
import recipesDocument from "../../public/recipes.json";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const recipe = recipesDocument.recipes.find((entry: any) => entry.meta?.slug === slug);
if (!recipe) throw new Error(`recipes.json has no recipe with slug ${slug}`);
if (!recipe.benchmark) throw new Error(`recipe ${slug} has no benchmark block to render`);
---

<div class="benchmark-mount" set:html={benchmarkHtml(recipe.benchmark)} />
