"""Launcher data the image installs below /opt/vllm-image.

The hardware profiles travel with the image so a launch resolves without a
network. The recipes no longer live here: one file per deployment sits in
//recipes, because a recipe is both what the launcher resolves and what the site
publishes, and two copies describing one deployment is the drift this repository
forbids. Our hardware profiles are a separate filegroup from the pinned upstream
directory they merge into, which is why a name collision there is a build failure
rather than an override.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "hardware",
    srcs = glob(["hardware/*.yaml"]),
)

# The resolved records the recipe tests diff against, and the frozen command and
# environment each recipe was accepted on. Both are read by
# image_tools/launcher_data_test.py in the host Python lane, and the accepted
# records are deliberately outside the goldens so a `--update` pass, which
# rewrites the goldens wholesale, cannot quietly restate history.
exports_files(glob(["golden/*.json", "accepted/*.json"]))

filegroup(
    name = "goldens",
    srcs = glob(["golden/*.json"]),
)

filegroup(
    name = "accepted",
    srcs = glob(["accepted/*.json"]),
)
