module(
    name = "vllm_multiarch_oci",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "1.7.0")
single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = ["//third_party:rules_python_raw_wheel.patch"],
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "container_structure_test", version = "1.22.1")

single_version_override(
    module_name = "gawk",
    patch_strip = 1,
    patches = ["//third_party:gawk_linkopts.patch"],
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "cuda_1331_cudnn_devel_ubuntu2604",
    digest = "sha256:ac4f1f98a10e63a6c6fec134f6e234205f92498f794a49ea674fad3192f54a37",
    image = "docker.io/nvidia/cuda",
    platforms = ["linux/amd64", "linux/arm64"],
)
use_repo(
    oci,
    "cuda_1331_cudnn_devel_ubuntu2604",
    "cuda_1331_cudnn_devel_ubuntu2604_linux_amd64",
    "cuda_1331_cudnn_devel_ubuntu2604_linux_arm64",
)

# The CUDA base owns CUDA and cuDNN. Install only the runtime tools that vLLM
# and B12X need, from a pinned Ubuntu archive for deterministic ARM64 layers.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main", "universe"],
    suites = [
        "resolute",
        "resolute-security",
    ],
    types = ["deb"],
    # Keep the snapshot as the authoritative index and checksum source. The
    # ports mirror supplies identical content-addressed debs when the snapshot
    # origin has a transient package-blob outage.
    uris = [
        "https://snapshot.ubuntu.com/ubuntu/20260901T000000Z",
        "mirror+https://ports.ubuntu.com/ubuntu-ports",
    ],
)
apt.install(
    dependency_set = "runtime_apt",
    packages = [
        "ca-certificates:arm64",
        # GDAKI's wrappers dynamically load libibverbs. Keep its ABI library
        # and the Mellanox provider plugin in the image. b12x also compiles
        # its RoCE proxy (b12x/comm/roce/_roce_proxy.c) in the container, so
        # infiniband/verbs.h must be present or RoCEnante falls back to NCCL.
        "ibverbs-providers:arm64",
        "libibverbs1:arm64",
        "libibverbs-dev:arm64",
        "liburing2:arm64",
        # b12x compiles its PLE reader inside the container on first use
        # (b12x/loader/_native.py) and enables the io_uring path only when
        # pkg-config reports liburing. Without the headers and pkgconf here,
        # disk-backed PLE fails at the first forward pass.
        "liburing-dev:arm64",
        # vLLM and its Python runtime preload mimalloc to replace glibc's
        # allocator throughout the serving process.
        "libmimalloc3:arm64",
        "pkgconf:arm64",
        "libnuma1:arm64",
        "pciutils:arm64",
        "python3:arm64",
    ],
    suites = [
        "resolute",
        "resolute-security",
    ],
)

apt.install(
    dependency_set = "runtime_apt_x86_64",
    packages = [
        "ca-certificates:amd64",
        "ibverbs-providers:amd64",
        "libibverbs1:amd64",
        "libibverbs-dev:amd64",
        "liburing2:amd64",
        "liburing-dev:amd64",
        "libmimalloc3:amd64",
        "pkgconf:amd64",
        "libnuma1:amd64",
        "pciutils:amd64",
        "python3:amd64",
    ],
    suites = [
        "resolute",
        "resolute-security",
    ],
)

# Native actions receive this complete compiler and libc tree as a declared
# input. It must not depend on GCC files preinstalled on a worker.
apt.install(
    dependency_set = "gcc_15_sysroot",
    packages = [
        "g++:arm64",
        # Native actions invoke these binaries directly. Keep them in the
        # declared sysroot instead of relying on a worker's PATH.
        "coreutils:arm64",
        "bash:arm64",
        "gawk:arm64",
        # PyTorch's CMake configuration runs ldd after linking host tools.
        # It must come from this declared sysroot, never from the worker.
        "libc-bin:arm64",
        "findutils:arm64",
        "grep:arm64",
        "make:arm64",
        # vLLM's Rust frontend vendors OpenSSL, whose Configure script is Perl.
        "perl:arm64",
        "patch:arm64",
        "pkgconf:arm64",
        "sed:arm64",
        "which:arm64",
        # Compile NCCL's net_ib and GDAKI transports against the same pinned
        # RDMA userspace ABI shipped in the runtime image.
        "libibverbs-dev:arm64",
        # DeepGEMM's deep_jit backend uses libdwfl for ELF inspection.
        "libdw-dev:arm64",
        "liburing-dev:arm64",
    ],
    suites = [
        "resolute",
        "resolute-security",
    ],
)

apt.install(
    dependency_set = "gcc_15_sysroot_x86_64",
    packages = [
        "g++:amd64",
        "coreutils:amd64",
        "bash:amd64",
        "gawk:amd64",
        "libc-bin:amd64",
        "findutils:amd64",
        "grep:amd64",
        "make:amd64",
        "perl:amd64",
        "patch:amd64",
        "pkgconf:amd64",
        "sed:amd64",
        "which:amd64",
        "libibverbs-dev:amd64",
        "libdw-dev:amd64",
        "liburing-dev:amd64",
    ],
    suites = [
        "resolute",
        "resolute-security",
    ],
)

# Local x86-64 builds execute ARM64 Python actions through this pinned static
# emulator. It is an action input, never a worker `/usr/bin` dependency.
apt.install(
    dependency_set = "qemu_aarch64_emulator",
    packages = ["qemu-user-static:amd64"],
    suites = [
        "resolute",
        "resolute-security",
    ],
)
use_repo(
    apt,
    "gcc_15_sysroot",
    "gcc_15_sysroot_x86_64",
    "qemu_aarch64_emulator",
    "runtime_apt",
    "runtime_apt_x86_64",
)

# Bazel caches whole actions, so one changed source recompiles a component from
# scratch. vLLM's incremental-build guide recovers per-file reuse through a
# compiler launcher; this supplies that launcher to the CUDA build actions.
ccache = use_extension("//bazel:ccache.bzl", "ccache")
use_repo(ccache, "ccache", "ccache_x86_64")

cuda = use_extension("//bazel:cuda_redist.bzl", "cuda_redist")
use_repo(cuda, "cuda_sbsa", "cuda_x86_64")

sources = use_extension("//bazel:sources.bzl", "profile_sources")
sources.profile(
    manifest = "//profiles/vllmb12x:profile.json",
    # Keep the Spark thermal scheduling control as a declared source input.
    # Its hash becomes part of source.identity.json.
    vllm_patches = [
        "//third_party:vllm_shm_broadcast_spin_grace.patch",
        "//third_party:vllm_flash_attn_cute_namespace.patch",
    ],
)
use_repo(
    sources,
    "vllmb12x_b12x",
    "vllmb12x_cutlass",
    "vllmb12x_deepgemm",
    "vllmb12x_exllamav3",
    "vllmb12x_flashinfer",
    "vllmb12x_instanttensor",
    "vllmb12x_lmcache",
    "vllmb12x_llguidance",
    "vllmb12x_nccl",
    "vllmb12x_torch",
    "vllmb12x_torchaudio",
    "vllmb12x_torchvision",
    "vllmb12x_vllm",
    "vllmb12x_vllm_cmake_cutlass",
    "vllmb12x_vllm_cmake_deepgemm",
    "vllmb12x_vllm_cmake_deepselect",
    "vllmb12x_vllm_cmake_flash_attn",
    "vllmb12x_vllm_cmake_flashkda",
    "vllmb12x_vllm_cmake_flashmla",
    "vllmb12x_vllm_cmake_msa",
    "vllmb12x_vllm_cmake_qutlass",
    "vllmb12x_vllm_cmake_tml_fa4",
    "vllmb12x_vllm_cmake_triton",
    "vllmb12x_xgrammar",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Resolve binary build dependencies for the platform that runs the action, not
# the x86_64 Bazel client that evaluates this module extension.
pip.default(
    arch_name = "aarch64",
    config_settings = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    os_name = "linux",
    platform = "manylinux_2_34_aarch64",
    whl_abi_tags = ["cp{major}{minor}"],
    whl_platform_tags = [
        "manylinux_2_34_aarch64",
        "manylinux_2_31_aarch64",
        "manylinux_2_28_aarch64",
        "manylinux_2_27_aarch64",
        "manylinux2014_aarch64",
    ],
)

pip.default(
    arch_name = "x86_64",
    config_settings = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    os_name = "linux",
    platform = "manylinux_2_31_x86_64",
    whl_abi_tags = ["cp{major}{minor}"],
    whl_platform_tags = [
        "manylinux_2_31_x86_64",
        "manylinux_2_28_x86_64",
        "manylinux2014_x86_64",
    ],
)
pip.parse(
    download_only = True,
    extra_pip_args = [
        "--platform=manylinux_2_34_aarch64",
        "--platform=manylinux_2_31_aarch64",
        "--platform=manylinux_2_28_aarch64",
        "--platform=manylinux2014_aarch64",
        "--python-version=312",
        "--implementation=cp",
        "--abi=cp312",
        "--abi=abi3",
    ],
    hub_name = "host_deps",
    python_version = "3.12",
    requirements_lock = "//profiles/vllmb12x:host-build-requirements.lock",
)
pip.parse(
    download_only = True,
    extra_pip_args = [
        "--platform=manylinux_2_34_aarch64",
        "--platform=manylinux_2_31_aarch64",
        "--platform=manylinux_2_28_aarch64",
        "--platform=manylinux2014_aarch64",
        "--python-version=312",
        "--implementation=cp",
        "--abi=cp312",
        "--abi=abi3",
    ],
    hub_name = "runtime_deps",
    python_version = "3.12",
    requirements_lock = "//profiles/vllmb12x:requirements.lock",
)
pip.parse(
    download_only = True,
    hub_name = "host_deps_x86_64",
    python_version = "3.12",
    requirements_lock = "//profiles/vllmb12x:host-build-requirements-x86_64.lock",
)
pip.parse(
    download_only = True,
    hub_name = "runtime_deps_x86_64",
    python_version = "3.12",
    requirements_lock = "//profiles/vllmb12x:requirements-x86_64.lock",
)
use_repo(pip, "host_deps", "host_deps_x86_64", "runtime_deps", "runtime_deps_x86_64")

register_toolchains(
    "//platforms:hermetic_linux_aarch64_cc_toolchain",
    "//platforms:hermetic_linux_x86_64_cc_toolchain",
)
