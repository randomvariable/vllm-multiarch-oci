+static PyObject* py_row_cache_confirm(PyObject* self, PyObject* args) {
+  (void)self;
+  PyObject* capsule;
+  int slot;
+  if (!PyArg_ParseTuple(args, "Oi", &capsule, &slot)) return NULL;
+  row_cache_t* rc = rc_from(capsule);
