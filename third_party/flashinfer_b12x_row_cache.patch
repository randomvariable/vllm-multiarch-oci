+static PyObject* py_row_cache_is_ready(PyObject* self, PyObject* args) {
+  (void)self;
+  PyObject* capsule;
+  long long key;
+  if (!PyArg_ParseTuple(args, "OL", &capsule, &key)) return NULL;
