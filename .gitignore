# Bazel's convenience output links and the local disk cache the Justfile
# recipes pass with --disk_cache=.bazel-cache. Both are per-checkout build
# scratch: committing them would pin one machine's paths into every worktree.
bazel-*
.bazel-cache/

# Bytecode left by running the scripts directly rather than through Bazel
__pycache__/
