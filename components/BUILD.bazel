    env = _FLASHINFER_JIT_ENV,
    host_wheels = _FLASHINFER_BUILD_WHEELS,
    nccl = "//components/nccl:sdk",
    output = select({
        "//platforms:linux_aarch64": "flashinfer_jit_cache-0.6.18-cp39-abi3-manylinux_2_28_aarch64.whl",
        "//platforms:linux_x86_64": "flashinfer_jit_cache-0.6.18-cp39-abi3-manylinux_2_28_x86_64.whl",
    }),
    cpu = 20,
    memory = 49152,
    # Ten concurrent AOT kernel compiles OOMKilled the worker (exit 137, four
    # attempts, 64GiB cgroup). Measured at five jobs on server21: 19-29 live
    # compiler processes, 12.91GiB peak for a single translation unit, and
    # 37.25GiB summed resident compiler memory, so roughly 7.5GiB per job.
    memory_per_job = 8192,
)

