# PEP 440 normalization leaves this version alone: the public part carries no
# redundant zeros and every local segment is alphanumeric, because the commit
# segment always starts with `g`. So one constant is both the build version and
# the wheel filename's version field.
_VLLM_WHEEL = select({
    "//platforms:linux_aarch64": "vllm-%s-cp312-cp312-linux_aarch64.whl" % VLLM_BUILD_VERSION,
    "//platforms:linux_x86_64": "vllm-%s-cp312-cp312-linux_x86_64.whl" % VLLM_BUILD_VERSION,
})

