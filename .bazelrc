try-import %workspace%/.bazelrc.user

common --registry=https://bcr.bazel.build
# Package indices and debs come from a snapshot origin that answers with
# transient 5xx under load. Bazel's default of five attempts and no connector
# retry window gives up inside a blip, and a module extension that cannot fetch
# one index fails the whole build rather than that one URL. Keep this pair in
# step with the same flags in the Justfile, which ignores rc files by design.
common --experimental_repository_downloader_retries=20
common --http_connector_retry_max_timeout=300s
build --disk_cache=.bazel-cache
build --incompatible_strict_action_env
test --test_output=errors

# Native ARM64 Blackwell builds target the full SM12x family.
build:spark --platforms=//platforms:blackwell_arm64_sm12x

# Private endpoints and credentials belong in the ignored .bazelrc.user file.
# Both ARM profiles keep the 120f image target and select execution hardware
# through NativeLink properties. The x86 executor supplies host/QEMU tools.
build:remote-sm120a --platforms=//platforms:blackwell_arm64_sm12x
build:remote-sm120a --extra_execution_platforms=//platforms:blackwell_arm64_sm12x,//platforms:blackwell_x86_64_sm120
build:remote-sm120a --extra_toolchains=//platforms:hermetic_linux_aarch64_cc_toolchain
build:remote-sm120a --remote_timeout=21600
build:remote-sm120a --spawn_strategy=remote
build:remote-sm120a --remote_local_fallback=false
build:remote-sm120a --remote_download_minimal
build:remote-sm120a --remote_cache_compression
build:remote-sm120a --experimental_remote_cache_compression_threshold=1048576
test:remote-sm120a --nocache_test_results

# Whole-build GB10 profile. CI instead overrides only its GB10 contract action
# so the ARM64 image dependencies retain their server21 execution properties.
build:remote-sm121a --platforms=//platforms:blackwell_arm64_sm12x
build:remote-sm121a --extra_execution_platforms=//platforms:blackwell_arm64_sm121a_gb10,//platforms:blackwell_x86_64_sm120
build:remote-sm121a --extra_toolchains=//platforms:hermetic_linux_aarch64_cc_toolchain
build:remote-sm121a --remote_timeout=21600
build:remote-sm121a --spawn_strategy=remote
build:remote-sm121a --remote_local_fallback=false
build:remote-sm121a --remote_download_minimal
build:remote-sm121a --remote_cache_compression
build:remote-sm121a --experimental_remote_cache_compression_threshold=1048576
test:remote-sm121a --nocache_test_results

# The x86 Blackwell lane builds CUDA sm_120 with native x86 tools. Private
# scheduler endpoints and container-image properties stay in .bazelrc.user.
build:remote-x86_64 --platforms=//platforms:blackwell_x86_64_sm120
build:remote-x86_64 --extra_execution_platforms=//platforms:blackwell_x86_64_sm120
build:remote-x86_64 --extra_toolchains=//platforms:hermetic_linux_x86_64_cc_toolchain
build:remote-x86_64 --remote_timeout=21600
build:remote-x86_64 --spawn_strategy=remote
build:remote-x86_64 --remote_local_fallback=false
build:remote-x86_64 --remote_download_minimal
build:remote-x86_64 --remote_cache_compression
build:remote-x86_64 --experimental_remote_cache_compression_threshold=1048576
test:remote-x86_64 --nocache_test_results

# Index transitions select the matching native architecture for each image.
build:remote-multiarch --extra_execution_platforms=//platforms:blackwell_arm64_sm12x,//platforms:blackwell_x86_64_sm120
build:remote-multiarch --extra_toolchains=//platforms:hermetic_linux_aarch64_cc_toolchain,//platforms:hermetic_linux_x86_64_cc_toolchain
build:remote-multiarch --remote_timeout=21600
build:remote-multiarch --spawn_strategy=remote
build:remote-multiarch --remote_local_fallback=false
build:remote-multiarch --remote_download_minimal
build:remote-multiarch --remote_cache_compression
build:remote-multiarch --experimental_remote_cache_compression_threshold=1048576
